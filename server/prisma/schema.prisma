// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Equipment {
  id                Int               @id @default(autoincrement())
  name              String
  typeModel         String
  category          String            @default("Other")
  location          String
  totalQuantity     Int
  availableQuantity Int
  condition         String
  approvalRequired  Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  guides            Guide[]
  troubleshooting   Troubleshooting[]
  loans             Loan[]
  units             EquipmentUnit[]
}

enum UnitStatus {
  AVAILABLE
  ON_LOAN
  OUT_OF_SERVICE
}

model EquipmentUnit {
  id          Int        @id @default(autoincrement())
  equipmentId Int
  identifier  String     @unique
  location    String
  condition   String
  status      UnitStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  loans     Loan[]
}

model Guide {
  id          Int      @id @default(autoincrement())
  equipmentId Int
  setup       String
  usage       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

model Troubleshooting {
  id          Int      @id @default(autoincrement())
  equipmentId Int
  problem     String
  solution    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

enum Role {
  STUDENT
  MAINTAINER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  loans        Loan[]
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED
}

enum LoanStatus {
  REQUESTED
  ACTIVE
  RETURNED
}

model Loan {
  id              Int            @id @default(autoincrement())
  equipmentId     Int
  equipmentUnitId Int?
  borrowerId      Int
  startDate       DateTime
  endDate         DateTime
  approvalStatus  ApprovalStatus
  loanStatus      LoanStatus
  returnedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  equipment     Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentUnit EquipmentUnit? @relation(fields: [equipmentUnitId], references: [id], onDelete: SetNull)
  borrower      User           @relation(fields: [borrowerId], references: [id], onDelete: Restrict)
}
